# ---- 数据库 ----
# SQLite（开发）：相对 prisma/schema.prisma 解析，库文件在 prisma/dev.db
# 生产切换 PostgreSQL 时改这一行 + schema 的 provider
DATABASE_URL="file:./dev.db"

# ---- 认证（Auth.js v5 / NextAuth）----
# 会话签名密钥：openssl rand -base64 32
AUTH_SECRET=change-me
# Auth.js v5
# AUTH_URL 不要写死 localhost：局域网 IP / 手机访问时登录后会被重定向到写死的地址。
# 本地开发保持注释（下方 AUTH_TRUST_HOST 会按请求头自动推断主机）；生产固定域名再配置。
# AUTH_URL=https://example.com
# 反向代理后取信任 Host（自托管/容器部署需要）
AUTH_TRUST_HOST=true

# GitHub OAuth 登录 + 账号绑定（可选；两项都配置后登录页出现 GitHub 按钮）
# 创建 OAuth App: https://github.com/settings/developers
# Authorization callback URL 填 <AUTH_URL>/api/auth/bind/github/callback
GITHUB_ID=
GITHUB_SECRET=

# ---- SEO ----
# 站点公开地址：sitemap.xml / robots.txt / OG metadataBase 的基址
# 不配置时回退 AUTH_URL（本地开发可都不配，缺省 http://localhost:3000）
# SITE_URL=https://example.com

# 站点名称：导航 logo / 浏览器标题 / OG siteName / 页脚（改后需重启 dev server）
# NEXT_PUBLIC_SITE_NAME=我的资源站

# 站点 logo（导航左上角徽标）：图片 URL 或路径，如 /my-logo.svg
# 不配置时默认用站点图标 src/app/icon.svg（与 favicon 同源，替换该文件即两处生效）
# NEXT_PUBLIC_SITE_LOGO=/my-logo.svg

# 站点图标（favicon/标签页图标）：替换 src/app/icon.svg 即可（Next 自动生成各尺寸引用）

# ---- 存储：local | s3 | chevereto（默认 local，文件落 public/uploads） ----
STORAGE_DRIVER=local

# S3 兼容（AWS S3 / R2 / MinIO / 各家对象存储）
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=auto
# S3_BUCKET=my-bucket
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# 公开访问基址（CDN/自定义域名）；缺省用 endpoint/bucket 拼接
# S3_PUBLIC_BASE=https://cdn.example.com
# 私有桶（默认 public-read，MinIO 不支持 ACL 时可设 private 走 CDN）
# S3_ACL=private

# chevereto 图床（V4 API）
# CHEVERETO_BASE=https://img.example.com
# CHEVERETO_API_KEY=

# ---- 邮件（可选） ----
# SMTP：找回密码 + 邮件通知（评论/审核结果）
# 未配置时：找回密码在开发环境直接展示重置链接；邮件通知自动关闭
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=
# MAIL_FROM=noreply@example.com
# 邮件通知总开关（需 SMTP 配置齐备才生效；每用户每小时最多 5 封）
# MAIL_NOTIFY=1
