// Prisma schema —— CMS 资源社区（见根目录 DESIGN.md §5）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // 2026-09-06 部署 Vercel 切 PG：本地=本机 PG18 cms，生产=Vercel env（Supabase avgrfktnmrnzxzkfqvpp）
  // url（runtime）= DATABASE_URL：生产走 transaction pooler 6543?pgbouncer=true（避免 serverless 打爆 session 连接池）
  // directUrl（migration/db push/seed）= DIRECT_URL：生产走 session pooler 5432；回滚 sqlite 需连改 provider 与两处 env
  provider   = "postgresql"
  url        = env("DATABASE_URL")
}

// ---------- 认证（Auth.js v5 + prisma adapter） ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String? // Credentials 登录
  name         String?
  avatarKey    String?
  bio          String?
  role         Role     @default(USER)
  trusted      Boolean  @default(false) // D6 白名单免审
  bannedAt     DateTime?
  bannedReason String?
  lastSeenAt   DateTime? // 在线状态：客户端心跳间隔更新，5 分钟内视为在线
  // ---- 主页隐私：收藏/粉丝/关注列表是否对外展示（本人始终可见）----
  showFavorites Boolean @default(false) // 收藏默认仅本人可见（延续原行为）
  showFollowers Boolean @default(true) // 粉丝列表默认公开（延续原行为）
  showFollowing Boolean @default(true) // 关注列表默认公开（延续原行为）

  accounts       Account[]
  sessions       Session[]
  resources      Resource[]
  comments       Comment[]
  likes          Like[]
  favorites      Favorite[]
  collections    Collection[]
  following      Follow[] @relation("Following")
  followers      Follow[] @relation("Follower")
  notifications  Notification[]
  actedNotifications Notification[] @relation("NotificationActor") // 作为触发者产生的通知
  filedReports   Report[] @relation("ReportReporter") // 发起的举报
  accusedReports Report[] @relation("ReportTargetUser") // 被举报记录
  passwordResets PasswordResetToken[]
  uploads        Media[]       @relation("Uploads")
  aiTasks        AiTask[]      @relation("AiTaskCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

// 找回密码：一次性 token（哈希落库，30 分钟有效，用过即焚）
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

// ---------- 分类与标签 ----------

model Category {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  parentId  String?
  sort      Int          @default(0)
  parent    Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]   @relation("CategoryTree")
  resources Resource[]
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  count Int    @default(0)
  items TagOnResource[]
}

// ---------- 内容 ----------

model Resource {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  summary       String?
  description   String
  type          ResourceType
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id])
  authorId      String
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  status        ResourceStatus @default(PENDING) // D6：默认待审
  rejectReason  String?

  coverMediaId String?
  coverMedia   Media?         @relation("Cover", fields: [coverMediaId], references: [id])
  media        Media[]        @relation("ResourceMedia")
  tags         TagOnResource[]
  versions     ResourceVersion[]
  comments     Comment[]
  likes        Like[]
  favorites    Favorite[]
  reports      Report[]       @relation("ReportResource") // 被举报目标

  viewCount     Int @default(0)
  likeCount     Int @default(0)
  favoriteCount Int @default(0)
  commentCount  Int @default(0)
  downloadCount Int @default(0)

  isDownloadable Boolean @default(true)
  loginRequired  Boolean @default(false) // D3：外链下载是否需登录
  nsfw           Boolean @default(false) // D9：NSFW 隔离 —— 未登录访客/搜索引擎不可见（列表不出现、详情 404、sitemap 不含）；登录后可见
  allowComments  Boolean @default(true)
  externalUrl    String? // D1：游戏/整包外链（网盘/直链）

  // D2 图片四类 / 游戏信息：类型化扩展，值为 JSON 文本（zod 校验后序列化）
  meta String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publishedAt DateTime?

  @@index([status, type])
  @@index([status, publishedAt(sort: Desc)])
  @@index([authorId])
  @@index([categoryId])
}

model Media {
  id         String     @id @default(cuid())
  resourceId String?
  resource   Resource?  @relation("ResourceMedia", fields: [resourceId], references: [id], onDelete: Cascade)
  coverOf    Resource[] @relation("Cover")
  commentId  String? // V1 评论带图（D8）
  comment    Comment?   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploaderId String? // 上传者：发布认领时校验属主（防 IDOR 抢他人素材）
  uploader   User?      @relation("Uploads", fields: [uploaderId], references: [id], onDelete: SetNull)

  kind       MediaKind
  storageKey String
  thumbKey   String? // 400w 缩略图键
  bigKey     String? // 1200w 大图键
  // 极低分辨率占位 data URI（sharp 生成，替代需外部库的 blurhash）
  placeholder String?
  width      Int?
  height     Int?
  size       Int?
  mime       String?
  fileName   String?
  checksum   String?
  sort       Int        @default(0)
  status     MediaStatus @default(PENDING_PROCESS)

  createdAt DateTime @default(now())

  @@index([resourceId])
  @@index([commentId])
  @@index([uploaderId])
}

model ResourceVersion {
  id            String @id @default(cuid())
  resourceId    String
  resource      Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  version       String
  changelog     String?
  url           String? // 该版本下载地址（缺省沿用资源 externalUrl）
  downloadCount Int    @default(0)
  createdAt     DateTime @default(now())

  @@index([resourceId, createdAt])
}

model TagOnResource {
  resourceId String
  tagId      String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([resourceId, tagId])
  @@index([tagId])
}

// ---------- 社交 ----------

model Like {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, resourceId])
  @@index([resourceId]) // 按资源删点赞（级联）/ 统计查询
}

model Favorite {
  id           String   @id @default(cuid())
  userId       String
  collectionId String?
  resourceId   String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection   Collection?  @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  resource     Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@unique([userId, resourceId])
  @@index([resourceId]) // 按资源删收藏（级联）
  @@index([collectionId]) // 删夹子置空 / 按夹子取成员
}

model Collection {
  id          String     @id @default(cuid())
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isPublic    Boolean    @default(true)
  items       Favorite[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([ownerId, name]) // 同一用户夹子名唯一：默认夹 upsert 与重命名防重的依据
  @@index([ownerId])
}

model Comment {
  id         String        @id @default(cuid())
  resourceId String
  resource   Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  authorId   String
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]     @relation("CommentReplies")
  media      Media[]
  content    String
  status     CommentStatus @default(PUBLIC)
  likeCount  Int           @default(0)
  createdAt  DateTime      @default(now())
  reports    Report[] @relation("ReportComment") // 举报目标（见 Report）

  @@index([resourceId, createdAt])
  @@index([parentId]) // 楼中楼按 parent 取回复
}

model Follow {
  followerId  String
  followingId String
  follower    User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("Follower", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  actorId    String?
  type       NotificationType
  resourceId String?
  commentId  String?
  message    String?
  readAt     DateTime?
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 触发者被删号 → actorId 置空（通知保留，显示为「系统」）
  actor      User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime         @default(now())

  @@index([userId, readAt])
  @@index([actorId])
}

// ---------- 治理 ----------

model Report {
  id                String       @id @default(cuid())
  reporterId        String?
  type              ReportTarget
  targetResourceId  String?
  targetCommentId   String?
  targetUserId      String?
  reason            String
  detail            String?
  status            ReportStatus @default(OPEN)
  handledBy         String?
  handledAt         DateTime?
  createdAt         DateTime     @default(now())
  // 目标/举报人是软引用：被删号或内容删除后置空，举报记录保留可追溯
  reporter          User?        @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  targetResource    Resource?    @relation("ReportResource", fields: [targetResourceId], references: [id], onDelete: SetNull)
  targetComment     Comment?     @relation("ReportComment", fields: [targetCommentId], references: [id], onDelete: SetNull)
  targetUser        User?        @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([type, status]) // 后台按类型+状态筛选
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String // BAN / UNBAN / TRUST / UNTRUST / REMOVE_RESOURCE / REJECT / RESTORE ...
  targetType String?
  targetId   String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([adminId]) // 按操作人追溯
  @@index([createdAt]) // 后台日志按时间倒序翻页
}

// ---------- 首页布局（WordPress 式板块引擎） ----------

model HomeSection {
  id        String   @id @default(cuid())
  kind      String // hero | categories | feed | stats | creators | tags
  title     String? // 板块标题（hero 作大标语）
  order     Int      @default(0)
  enabled   Boolean  @default(true)
  config    String? // 板块配置 JSON 文本（zod 校验后序列化）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// ---------- 站点外观 / 布局（全局设置，值 JSON 文本经 zod 校验） ----------
// key 约定：theme —— 站点级侧边栏 + 详情页模板默认 等外观配置

model SiteSetting {
  key   String @id
  value String // JSON 文本
  // 乐观锁版本号：后台并发编辑 theme 时后写者检测到版本变动即拒绝（updateMany where version）
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- 云端附件驱动器（Microsoft Graph app-only） ----------
// 仅大文件 ATTACHMENT 写 active 驱动器；图片管线仍用 STORAGE_DRIVER。
// locator（Graph 驱动定位）：drives/{driveId} | sites/{siteId}/drive
//   | sites/{host}:/sites/{team}:/drive | users/{upn}/drive | groups/{groupId}/drive
// rootPath 只影响新上传（/od 存储引用自带完整路径，改 rootPath 不影响存量下载）。
model CloudDrive {
  id        String   @id @default(cuid())
  label     String // 展示名（后台识别用）
  locator   String // Graph 驱动定位串（见上注释，唯一可换成新建盘）
  rootPath  String   @default("") // 顶层前缀 [A-Za-z0-9._-]，单段，可空
  active    Boolean  @default(false) // 全局仅一个为 true（由 action 事务维护）
  enabled   Boolean  @default(true) // 关闭后新上传回退原存储
  lastError String?  @db.Text // 最近一次上传/探测失败信息（后台排查）
  lastOkAt  DateTime? // 最近一次成功连通（上传/探测）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, enabled])
}

// ---------- 枚举 ----------

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum ResourceType {
  GAME
  IMAGE
  ARTICLE
}

enum ResourceStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  REMOVED
}

enum MediaKind {
  COVER
  GALLERY
  ORIGINAL
  ATTACHMENT
}

enum MediaStatus {
  PENDING_PROCESS
  READY
  FAILED
}

enum CommentStatus {
  PUBLIC
  HIDDEN
  DELETED
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  MODERATION
  SYSTEM
}

enum ReportTarget {
  RESOURCE
  COMMENT
  USER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// ---------- AI 建议与运行记录 ----------
// AI 只产出任务/建议草稿，审核或既有业务流程显式采纳后才会影响内容；模型输出写库前已脱敏。
model AiTask {
  id             String       @id @default(cuid())
  kind           AiTaskKind
  status         AiTaskStatus @default(QUEUED)
  inputJson      String       @db.Text // 任务输入快照（写入前已递归脱敏）
  promptVersion  String // 本次任务的提示词版本，便于追溯结果由哪版模型约定产生
  idempotencyKey String?      @unique // 幂等键：触发器/重复点击复用同一任务
  createdById    String?
  createdBy      User?        @relation("AiTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  suggestions    AiSuggestion[]
  sources        AiSource[]
  runs           AiRun[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([kind, status])
  @@index([createdById])
  @@index([createdAt])
}

model AiSuggestion {
  id           String             @id @default(cuid())
  taskId       String
  task         AiTask             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status       AiSuggestionStatus @default(PENDING)
  outputJson   String             @db.Text // 模型输出（已按任务类型 Zod 校验后序列化）
  decisionJson String?            @db.Text // 逐字段接受/拒绝记录 {accepted[], rejected[]}
  reviewedById String? // 处理人（不建强关系：人员删除不影响审计可追溯）
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([taskId, status])
}

model AiSource {
  id         String       @id @default(cuid())
  taskId     String
  task       AiTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind       AiSourceKind @default(USER_INPUT)
  title      String?
  locator    String? // http(s) 地址或站内资源/标识（页面仅对 http(s) 渲染为外链）
  excerpt    String?      @db.Text
  trustLevel String? // 来源可信等级（research 适配器落地后由抓取方填充）
  fetchedAt  DateTime?
  createdAt  DateTime     @default(now())

  @@index([taskId])
}

model AiRun {
  id           String      @id @default(cuid())
  taskId       String
  task         AiTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  provider     String // 执行用 provider 标识（当前固定 openai-compatible）
  model        String // 执行用模型名
  status       AiRunStatus @default(RUNNING)
  startedAt    DateTime
  completedAt  DateTime?
  durationMs   Int? // 请求耗时（毫秒）
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  errorMessage String?      @db.Text // 失败原因（保留服务端排查上下文，不直接展示给用户）
  createdAt    DateTime     @default(now())

  @@index([taskId, createdAt])
  @@index([status, createdAt])
}

enum AiTaskKind {
  RESOURCE_ENRICH // 缺简介补全
  RESOURCE_REVIEW // 发布前内容审核
  IMAGE_DESCRIBE // 图片描述与打标
  GAME_RESEARCH // 游戏资料研究（首期无检索适配器，执行时明确失败）
  SITE_OVERVIEW // 站点级周期运营建议（输入=最近 7 日访客浏览聚合快照，产出只读建议，不写资源）
}

enum AiTaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum AiSuggestionStatus {
  PENDING // 待审核（含部分字段已处理、其余仍待决定）
  PROCESSING // 正在应用到资源（条件抢占，防并发重复写入）
  ACCEPTED
  REJECTED
}

enum AiSourceKind {
  USER_INPUT
  IMPORTED
}

enum AiRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// 站点访问统计（PV / IP）：每次页面浏览一行；ipHash 为加盐哈希不存明文 IP
model Visit {
  id        Int      @id @default(autoincrement())
  day       String   // 本地日期 YYYY-MM-DD，按天聚合用
  ipHash    String
  path      String
  createdAt DateTime @default(now())

  @@index([day])
  @@index([day, ipHash])
}
