// Prisma schema —— CMS 资源社区（见根目录 DESIGN.md §5）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // 2026-09-06 部署 Vercel 切 PG：本地=本机 PG18 cms，生产=Vercel env（Supabase avgrfktnmrnzxzkfqvpp）
  // url（runtime）= DATABASE_URL：生产走 transaction pooler 6543?pgbouncer=true（避免 serverless 打爆 session 连接池）
  // directUrl（migration/db push/seed）= DIRECT_URL：生产走 session pooler 5432；回滚 sqlite 需连改 provider 与两处 env
  provider   = "postgresql"
  url        = env("DATABASE_URL")
}

// ---- 全文搜索镜像表（pg.ts 用 raw SQL 建表，这里加模型占位以防 db push 误删）----
model ResourceSearchDoc {
  resourceId String   @id
  searchText String
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("ResourceSearchDoc")
}

// ---------- 认证（Auth.js v5 + prisma adapter） ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String? // Credentials 登录
  name         String?
  avatarKey    String?
  heroImageKey String? // 个人主页 hero 横幅图（可选；未设置则头部按原版展示）
  // ---- 个人主页背景（铺满视口的最底层底图，达等级才开放；未设置则不渲染）。仅桌面端展示 ----
  profileBgPcKey String? // 左右两侧经横向遮罩渐显，贴屏幕边缘最清晰（窄屏不渲染）
  bio          String?
  role         Role     @default(USER)
  trusted      Boolean  @default(false) // D6 白名单免审
  bannedAt     DateTime?
  bannedReason String?
  lastSeenAt   DateTime? // 在线状态：客户端心跳间隔更新，5 分钟内视为在线
  // ---- 主页隐私：收藏/粉丝/关注列表是否对外展示（本人始终可见）----
  showFavorites Boolean @default(false) // 收藏默认仅本人可见（延续原行为）
  showFollowers Boolean @default(true) // 粉丝列表默认公开（延续原行为）
  showFollowing Boolean @default(true) // 关注列表默认公开（延续原行为）
  emailNotifyComment Boolean @default(true) // 评论/回复我的内容时邮件提醒（默认开启）
  emailNotifyModeration Boolean @default(true) // 投稿审核结果邮件提醒（默认开启）
  // ---- 站内通知开关（默认全开）。账号安全类（SECURITY）不受开关控制，始终送达 ----
  inAppNotifyLike Boolean @default(true) // 点赞
  inAppNotifyComment Boolean @default(true) // 评论与回复
  inAppNotifyFollow Boolean @default(true) // 关注
  inAppNotifySystem Boolean @default(true) // 审核结果与系统公告
  autoSaveDraft Boolean @default(true) // 发布向导：边写边自动存草稿（用户可在设置里关掉，改为手动保存）
  // ---- 图片水印（默认关闭）。开启后上传的图集/评论附图会被打上文字水印，原图同样改写 ----
  watermarkImages Boolean @default(false) // 是否给上传的图片加水印
  watermarkText   String? // 水印文字；空 = 用默认「@用户名」

  accounts       Account[]
  sessions       Session[]
  resources      Resource[]
  comments       Comment[]
  likes          Like[]
  favorites      Favorite[]
  collections    Collection[]
  following      Follow[] @relation("Following")
  followers      Follow[] @relation("Follower")
  notifications  Notification[]
  actedNotifications Notification[] @relation("NotificationActor") // 作为触发者产生的通知
  filedReports   Report[] @relation("ReportReporter") // 发起的举报
  accusedReports Report[] @relation("ReportTargetUser") // 被举报记录
  passwordResets PasswordResetToken[]
  uploads        Media[]       @relation("Uploads")
  drafts         ResourceDraft[] @relation("ResourceDrafts")
  // ---- 创作者激励 ----
  points          UserPoint?
  pointLogs       PointLog[]
  coinAccount     CoinAccount?
  coinLedger      CoinLedger[]
  withdrawals     WithdrawalRequest[]
  payouts         IncentivePayout[]
  tipsSent        TipRecord[]       @relation("TipFrom")
  tipsReceived    TipRecord[]       @relation("TipTo")
  downloadRecords DownloadRecord[]
  // ---- 支付 ----
  orders PaymentOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

// 找回密码：一次性 token（哈希落库，30 分钟有效，用过即焚）
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

// ---------- 分类与标签 ----------

model Category {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  parentId  String?
  sort      Int          @default(0)
  parent    Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]   @relation("CategoryTree")
  resources Resource[]
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  count Int    @default(0)
  items TagOnResource[]
}

// ---------- 内容 ----------

model Resource {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  summary       String?
  description   String
  type          ResourceType
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id])
  authorId      String
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  status        ResourceStatus @default(PENDING) // D6：默认待审
  rejectReason  String?

  coverMediaId String?
  coverMedia   Media?         @relation("Cover", fields: [coverMediaId], references: [id])
  media        Media[]        @relation("ResourceMedia")
  tags         TagOnResource[]
  versions     ResourceVersion[]
  comments     Comment[]
  likes        Like[]
  favorites    Favorite[]
  reports      Report[]       @relation("ReportResource") // 被举报目标
  downloadRecords DownloadRecord[]
  tips            TipRecord[]

  viewCount     Int @default(0)
  likeCount     Int @default(0)
  favoriteCount Int @default(0)
  commentCount  Int @default(0)
  downloadCount Int @default(0)

  isDownloadable Boolean @default(true)
  loginRequired  Boolean @default(false) // D3：外链下载是否需登录
  nsfw           Boolean @default(false) // D9：NSFW 隔离 —— 未登录访客/搜索引擎不可见（列表不出现、详情 404、sitemap 不含）；登录后可见
  allowComments  Boolean @default(true)
  externalUrl    String? // D1：游戏/整包外链（网盘/直链）

  // D2 图片四类 / 游戏信息：类型化扩展，值为 JSON 文本（zod 校验后序列化）
  meta String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publishedAt DateTime?

  @@index([status, type])
  @@index([status, publishedAt(sort: Desc)])
  @@index([authorId])
  @@index([categoryId])
}

/// 发布向导草稿快照：只存「用户已填了什么」，不参与审核、不进前台查询、不计入任何统计。
/// 独立建表而不是复用 Resource(status=DRAFT)：半成品拿不到必填字段、slug 唯一与聚合计数，
/// 硬塞进去会污染资源表；独立表也让草稿可以随时整条丢弃，不影响已发布内容。
model ResourceDraft {
  id        String       @id @default(cuid())
  ownerId   String
  owner     User         @relation("ResourceDrafts", fields: [ownerId], references: [id], onDelete: Cascade)
  type      ResourceType
  title     String       @default("") // 列表展示用；空标题回落到「未命名草稿」
  payload   String // 向导全量字段的 JSON 快照（结构见 src/lib/draft.ts）
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([ownerId, updatedAt(sort: Desc)])
}

model Media {
  id         String     @id @default(cuid())
  resourceId String?
  resource   Resource?  @relation("ResourceMedia", fields: [resourceId], references: [id], onDelete: Cascade)
  coverOf    Resource[] @relation("Cover")
  commentId  String? // V1 评论带图（D8）
  comment    Comment?   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploaderId String? // 上传者：发布认领时校验属主（防 IDOR 抢他人素材）
  uploader   User?      @relation("Uploads", fields: [uploaderId], references: [id], onDelete: SetNull)

  kind       MediaKind
  storageKey String
  thumbKey   String? // 400w 缩略图键
  bigKey     String? // 1200w 大图键
  // 极低分辨率占位 data URI（sharp 生成，替代需外部库的 blurhash）
  placeholder String?
  width      Int?
  height     Int?
  size       Int?
  mime       String?
  fileName   String?
  checksum   String?
  sort       Int        @default(0)
  status     MediaStatus @default(PENDING_PROCESS)

  createdAt DateTime @default(now())

  @@index([resourceId])
  @@index([commentId])
  @@index([uploaderId])
}

model ResourceVersion {
  id            String @id @default(cuid())
  resourceId    String
  resource      Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  version       String
  changelog     String?
  url           String? // 该版本下载地址（缺省沿用资源 externalUrl）
  downloadCount Int    @default(0)
  createdAt     DateTime @default(now())

  @@index([resourceId, createdAt])
}

model TagOnResource {
  resourceId String
  tagId      String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([resourceId, tagId])
  @@index([tagId])
}

// ---------- 社交 ----------

model Like {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, resourceId])
  @@index([resourceId]) // 按资源删点赞（级联）/ 统计查询
}

model Favorite {
  id           String   @id @default(cuid())
  userId       String
  collectionId String?
  resourceId   String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection   Collection?  @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  resource     Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@unique([userId, resourceId])
  @@index([resourceId]) // 按资源删收藏（级联）
  @@index([collectionId]) // 删夹子置空 / 按夹子取成员
}

model Collection {
  id          String     @id @default(cuid())
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isPublic    Boolean    @default(true)
  items       Favorite[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([ownerId, name]) // 同一用户夹子名唯一：默认夹 upsert 与重命名防重的依据
  @@index([ownerId])
}

model Comment {
  id         String        @id @default(cuid())
  resourceId String
  resource   Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  authorId   String
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]     @relation("CommentReplies")
  media      Media[]
  content    String
  status     CommentStatus @default(PUBLIC)
  likeCount  Int           @default(0)
  createdAt  DateTime      @default(now())
  reports    Report[] @relation("ReportComment") // 举报目标（见 Report）

  @@index([resourceId, createdAt])
  @@index([parentId]) // 楼中楼按 parent 取回复
}

model Follow {
  followerId  String
  followingId String
  follower    User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("Follower", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  actorId    String?
  type       NotificationType
  resourceId String?
  commentId  String?
  message    String?
  // 聚合计数：点赞在同一批未读里合并为一条，count>1 时前端显示「X 等 N 人赞了你」
  count      Int              @default(1)
  readAt     DateTime?
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 触发者被删号 → actorId 置空（通知保留，显示为「系统」）
  actor      User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime         @default(now())

  @@index([userId, readAt])
  @@index([actorId])
}

// ---------- 治理 ----------

model Report {
  id                String       @id @default(cuid())
  reporterId        String?
  type              ReportTarget
  targetResourceId  String?
  targetCommentId   String?
  targetUserId      String?
  reason            String
  detail            String?
  status            ReportStatus @default(OPEN)
  handledBy         String?
  handledAt         DateTime?
  createdAt         DateTime     @default(now())
  // 目标/举报人是软引用：被删号或内容删除后置空，举报记录保留可追溯
  reporter          User?        @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  targetResource    Resource?    @relation("ReportResource", fields: [targetResourceId], references: [id], onDelete: SetNull)
  targetComment     Comment?     @relation("ReportComment", fields: [targetCommentId], references: [id], onDelete: SetNull)
  targetUser        User?        @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([type, status]) // 后台按类型+状态筛选
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String // BAN / UNBAN / TRUST / UNTRUST / REMOVE_RESOURCE / REJECT / RESTORE ...
  targetType String?
  targetId   String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([adminId]) // 按操作人追溯
  @@index([createdAt]) // 后台日志按时间倒序翻页
}

// ---------- 首页布局（WordPress 式板块引擎） ----------

model HomeSection {
  id          String   @id @default(cuid())
  kind        String // hero | categories | feed | stats | creators | tags
  title       String? // 板块标题（hero 作大标语）
  order       Int      @default(0)
  enabled     Boolean  @default(true)
  // 可见性：设备端（all=不限 / pc=仅电脑端 / mobile=仅移动端）+ 是否仅登录可见
  visibleOn   String   @default("all")
  requireAuth Boolean  @default(false)
  config      String? // 板块配置 JSON 文本（zod 校验后序列化）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

// ---------- 站点外观 / 布局（全局设置，值 JSON 文本经 zod 校验） ----------
// key 约定：theme —— 站点级侧边栏 + 详情页模板默认 等外观配置

model SiteSetting {
  key   String @id
  value String // JSON 文本
  // 乐观锁版本号：后台并发编辑 theme 时后写者检测到版本变动即拒绝（updateMany where version）
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- 云端附件驱动器（Microsoft Graph app-only） ----------
// 仅大文件 ATTACHMENT 写 active 驱动器；图片管线仍用 STORAGE_DRIVER。
// locator（Graph 驱动定位）：drives/{driveId} | sites/{siteId}/drive
//   | sites/{host}:/sites/{team}:/drive | users/{upn}/drive | groups/{groupId}/drive
// rootPath 只影响新上传（/od 存储引用自带完整路径，改 rootPath 不影响存量下载）。
model CloudDrive {
  id        String   @id @default(cuid())
  label     String // 展示名（后台识别用）
  locator   String // Graph 驱动定位串（见上注释，唯一可换成新建盘）
  rootPath  String   @default("") // 顶层前缀 [A-Za-z0-9._-]，单段，可空
  active    Boolean  @default(false) // 全局仅一个为 true（由 action 事务维护）
  enabled   Boolean  @default(true) // 关闭后新上传回退原存储
  lastError String?  @db.Text // 最近一次上传/探测失败信息（后台排查）
  lastOkAt  DateTime? // 最近一次成功连通（上传/探测）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, enabled])
}

// ---------- 枚举 ----------

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum ResourceType {
  GAME
  IMAGE
  ARTICLE
  MUSIC
  VIDEO
}

enum ResourceStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  REMOVED
}

enum MediaKind {
  COVER
  GALLERY
  ORIGINAL
  ATTACHMENT
}

enum MediaStatus {
  PENDING_PROCESS
  READY
  FAILED
}

enum CommentStatus {
  PUBLIC
  HIDDEN
  DELETED
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  MODERATION
  SECURITY // 账号安全提醒（改密/换邮箱/封禁解封/角色变更）：不受站内开关控制
  SYSTEM
}

enum ReportTarget {
  RESOURCE
  COMMENT
  USER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// 站点访问统计（PV / IP）：每次页面浏览一行；ipHash 为加盐哈希不存明文 IP
model Visit {
  id        Int      @id @default(autoincrement())
  day       String   // 本地日期 YYYY-MM-DD，按天聚合用
  ipHash    String
  path      String
  createdAt DateTime @default(now())

  @@index([day])
  @@index([day, ipHash])
}

// ---- 集中式限流命中（H2 修复：替代原内存 Map，跨 Vercel 多实例共享计数）----
// 表由手工 SQL 迁移建立（见 prisma/migrations/0001_rate_limit_register_code.sql）；
// 此处保留模型以防 `prisma db push` 误删。ts 为 TIMESTAMP(3)，写入/清理均走 DB 服务端 now()，无时区漂移。
model RateLimitHit {
  id String   @id @default(cuid())
  key String
  ts  DateTime @default(now())

  @@index([key])
  @@index([ts])
}

// ---- 注册邮箱验证码（H2/M2 修复：替代原内存 Map，多实例下签发/验证一致）----
model RegisterCode {
  email     String   @id
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
}

// ---------- 创作者激励（贡献分 / PIX / 结算 —— 见 creator-incentive-plan.md） ----------
// 命名纪律：Contribution **贡献分**（荣誉层，只增不减）与 **PIX**（资产层，会因提现/打赏减少）
// 是两套独立数字，任何一处混用都会让口径失效。连接点只有「每期结算 = 贡献分 → PIX 的单向兑换」。
// 资金纪律：`LedgerEntry`（见 payment-plan.md）只记真钱进出；结算分配只抬升「PIX 负债」，不进那张表。

/// 贡献分余额（荣誉层，物化；事实来源 PointLog，可随时重算对账）
/// 注：**刻意没有 frozen 列** —— 「冻结计分」只认配置 `risk.frozenUserIds`
/// （points-config.ts）。曾经同时存在「列」与「配置」两个来源，写侧读配置、读侧读列，
/// 会把后台加的冻结名单静默失效。现在单一事实来源 = 配置。
model UserPoint {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  level     Int      @default(0) // 冗余等级，仅供排序（事实来源是 levelOf(balance)）
  updatedAt DateTime @updatedAt

  @@index([balance(sort: Desc)])
  @@index([level])
}

/// 贡献分流水（事实来源）。口径「累计获得不回冲」：取消点赞不产生负向记录
model PointLog {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorId   String? // 触发者（拦截自产自销）；不建关系：触发者可能已注销
  reason    PointReason
  delta     Int
  refId     String? // 幂等键（语义见计划 §5）；ADMIN_ADJUST 用 null
  balance   Int // 记账后余额快照，便于对账
  note      String?
  createdAt DateTime    @default(now())

  @@unique([userId, reason, refId]) // 幂等闸门：同 reason + refId 只可能有一条
  @@index([userId, createdAt(sort: Desc)])
  @@index([reason, createdAt])
}

/// PIX 账户（资产层）
model CoinAccount {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance           Int      @default(0) // 可用 PIX
  frozen            Int      @default(0) // 提现申请中冻结
  lifetimeEarned    Int      @default(0) // 累计获得（不因提现/打赏减少）
  lifetimeWithdrawn Int      @default(0)
  lifetimeTippedOut Int      @default(0) // 累计打赏出去
  updatedAt         DateTime @updatedAt

  @@index([balance(sort: Desc)])
}

/// PIX 流水（事实来源）
model CoinLedger {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int // 正=入账，负=出账
  kind      CoinReason
  refType   String? // SETTLE_PERIOD | TIP | WITHDRAWAL | MANUAL
  refId     String? // 幂等键
  balance   Int // 记账后可用余额快照
  note      String?
  createdAt DateTime   @default(now())

  @@unique([userId, kind, refId])
  @@index([userId, createdAt(sort: Desc)])
}

/// 打赏记录：一笔打赏 = 两条 CoinLedger（发出方 −N、接收方 +N），全站 Σ PIX 不变
model TipRecord {
  id         String    @id @default(cuid())
  fromUserId String
  fromUser   User      @relation("TipFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User      @relation("TipTo", fields: [toUserId], references: [id], onDelete: Cascade)
  resourceId String?
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  coin       Int // PIX 数量
  message    String? // 附言（≤60 字，过敏感词）
  createdAt  DateTime  @default(now())

  @@index([toUserId, createdAt(sort: Desc)])
  @@index([fromUserId, createdAt(sort: Desc)])
  @@index([resourceId])
}

/// 提现申请。accountInfo 为敏感字段：仅 adminOnly 可见，永不进日志/公示页
model WithdrawalRequest {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  coinAmount   Int // 申请提现的 PIX
  fiatFen      Int // 折算金额（分）—— 提交时快照
  rateSnapshot Int // 提交时的兑换比例（PIX/元）
  feeFen       Int            @default(0)
  status       WithdrawStatus @default(PENDING)
  method       String // alipay | wechat
  accountInfo  String // 收款账号 + 姓名
  note         String?
  handledBy    String?
  handledAt    DateTime?
  rejectNote   String?
  paidAt       DateTime?
  payRef       String?
  createdAt    DateTime       @default(now())

  @@index([status, createdAt])
  @@index([userId, createdAt(sort: Desc)])
}

/// 下载记录：同时承担「下载量去重」与「计分去重」（写记录成功才计一次）
model DownloadRecord {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  subjectKey String // 登录 `u:<userId>`；匿名 `ip:<ipHash>`
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipHash     String // 加盐哈希，与 Visit.ipHash 同算法（src/lib/ip.ts）
  periodKey  String // YYYY-MM
  counted    Boolean  @default(true) // 是否通过当期计分闸门（排查用）
  createdAt  DateTime @default(now())

  @@unique([resourceId, subjectKey]) // 主体级去重：同一主体对同一作品只计一次
  @@index([subjectKey, periodKey])
  @@index([resourceId, periodKey])
  @@index([periodKey])
}

/// 收入录入（纪律：仅在钱**已实际到账**后录入，否则偿付水位公式是假的）
model RevenueEntry {
  id         String   @id @default(cuid())
  periodKey  String // 归属期 YYYY-MM
  source     String // 联盟广告 / 站点赞助 / 其他
  amountFen  Int
  receivedAt DateTime
  note       String?
  createdBy  String
  createdAt  DateTime @default(now())

  @@index([periodKey])
}

/// 结算期（确认后金额与名次冻结为快照 —— 已公示的数字必须永远可复算）
model IncentivePeriod {
  id             String          @id @default(cuid())
  periodKey      String          @unique
  status         IncentiveStatus @default(DRAFT)
  revenueFen     Int             @default(0)
  ratePermille   Int             @default(0)
  carryInFen     Int             @default(0) // 上期未发完的池余：**全额**回流，不再乘分成比例
  poolFen        Int             @default(0)
  totalScore     Int             @default(0)
  paidFen        Int             @default(0)
  carryOutFen    Int             @default(0)
  configSnapshot String? // 确认时冻结配置：事后改配置不影响已确认期
  confirmedAt    DateTime?
  confirmedBy    String?
  note           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  payouts IncentivePayout[]
}

/// 结算明细（确认后锁定；公示与审计的唯一依据）
model IncentivePayout {
  id           String          @id @default(cuid())
  periodId     String
  period       IncentivePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  score        Int
  rank         Int
  amountFen    Int
  coin         Int // 折算 PIX（冻结值）
  capped       Boolean         @default(false)
  coinCredited Boolean         @default(false) // 防重复入账
  createdAt    DateTime        @default(now())

  @@unique([periodId, userId])
  @@index([userId, createdAt(sort: Desc)])
}

/// 贡献分／结算分的来源。新增值必须同步 `points-config.ts` 的文案表与默认分值
enum PointReason {
  PUBLISH
  LIKE_RECEIVED
  FAVORITE_RECEIVED
  DOWNLOAD_RECEIVED
  COMMENT_RECEIVED
  FOLLOWER_GAINED
  FEATURED
  DAILY_LOGIN
  ADMIN_ADJUST
}

/// PIX 流动方向。SETTLE 是唯一的新增来源（PIX 总量只由激励池创造，打赏只是搬运）
enum CoinReason {
  SETTLE
  TIP_SENT
  TIP_RECEIVED
  WITHDRAW_FREEZE
  WITHDRAW_PAID
  WITHDRAW_REFUND
  ADMIN_ADJUST
}

enum WithdrawStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum IncentiveStatus {
  DRAFT
  CONFIRMED
  PAID
}

// ---------- 支付（易支付 Epay）—— 见 payment-plan.md ----------
// 命名纪律：本组模型**只记真钱进站**。创作者分成不进这里（那只是 PIX 负债上升，记在
// IncentivePeriod / IncentivePayout）；打赏是站内 PIX 转账，**永不产生 PaymentOrder**。
// 两件事混进一张表，账永远对不平（creator-incentive-plan.md §3.4 现金/负债分离表）。

/// 支付订单（唯一事实来源；微信/支付宝侧只负责把状态推回来）
model PaymentOrder {
  id          String      @id @default(cuid())
  outTradeNo  String      @unique // 发给易支付的商户订单号（cuid，不可预测 —— 防枚举、防伪造回调）
  kind        OrderKind
  userId      String? // 付款人；未登录赞助可为空
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  amountFen   Int // 金额，单位：分（全链路整数，不出现浮点）
  subject     String // 提交给易支付的商品名
  periodKey   String? // 归属期 YYYY-MM（赞助计入哪一期激励池的收入）
  status      OrderStatus @default(PENDING)
  // 上游回执
  epayTradeNo String?
  payType     String? // alipay / wxpay
  notifyRaw   String? // 回调原始 query（审计用；**落库前已剔除 key/sign**）
  paidAt      DateTime?
  refundedFen Int         @default(0)
  // 展示与风控
  message     String? // 赞助留言
  anonymous   Boolean     @default(false)
  displayName String? // 鸣谢墙展示名快照（匿名 = null）；用户名事后改了不重写历史
  ipHash      String? // 加盐哈希（不存明文 IP），供刷单排查
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([kind, periodKey])
  @@index([kind, status, paidAt]) // 鸣谢墙按「已支付 + 时间」取
  @@index([userId])
}

/// 订单种类。QUOTA 属支付二期（需前置配额体系），一期只落 SPONSOR
enum OrderKind {
  SPONSOR // 站点赞助（覆盖成本 + 进激励池）
  QUOTA // 容量扩容包
}

enum OrderStatus {
  PENDING
  PAID
  CLOSED // 超时未支付 / 用户放弃
  REFUNDED
}

/// 收支台账：**只记真钱进出**（收入 / 成本 / 提现打款）。
/// 结算分配（向创作者入账 PIX）**不进这张表** —— 它只抬升代币负债，钱还没出去。
model LedgerEntry {
  id        String     @id @default(cuid())
  periodKey String // YYYY-MM
  kind      LedgerKind
  direction String // IN（收入） / OUT（支出）—— 由 LEDGER_KIND_META 派生，唯一写入口填
  amountFen Int
  note      String?
  refType   String? // PAYMENT_ORDER | WITHDRAWAL | MANUAL
  refId     String? // 关联单据 id；与 kind 组成幂等键（MANUAL 可留空，NULL 不参与唯一约束）
  createdBy String?
  createdAt DateTime   @default(now())

  @@unique([kind, refId]) // 幂等：同一单据同一科目只可能有一条
  @@index([periodKey, direction])
  @@index([createdAt(sort: Desc)])
}

/// 台账科目。direction 由代码里的科目表派生，库里同步存一份供 SQL 聚合
enum LedgerKind {
  COST_SERVER // OUT
  COST_STORAGE // OUT
  COST_DOMAIN // OUT
  COST_OTHER // OUT
  INCOME_SPONSOR // IN
  INCOME_AD // IN
  INCOME_OTHER // IN
  WITHDRAWAL_PAID // OUT，创作者提现打款（独立成组：它不是「运营成本」）
  REFUND_SPONSOR // OUT，赞助原路退回（独立成组：它是「收入冲减」，不是成本）
}
